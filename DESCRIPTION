Package: ActiSleep
Type: Package
Title: Sleep Duration Estimation from Accelerometer Data
Version: 1.0.0
Date: 2026-04-16
Authors@R: c(
    person("Jonggyu", "Baek", email = "Jonggyu.Baek@umassmed.edu", role = "aut"),
    person("Margaret", "Banker", email = "margaret.banker@northwestern.edu", role = "aut"),
